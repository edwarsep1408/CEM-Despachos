# CEM-Despachos — copiar a .env y ajustar.
# Este archivo sí se versiona. .env no.

# App
PORT=3020
WEB_PORT=4220

# Login local (sin SSO)
LOCAL_LOGIN_USER=admin
LOCAL_LOGIN_PASSWORD=admin
JWT_SECRET=cambiar-este-secreto-en-local

# Mongo — local sin Docker (puerto 27027 en el host)
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27027
MONGODB_DB=cem-db_distribuccion
MONGODB_USER=cem
MONGODB_PASSWORD=cemlocal
MONGODB_AUTH_SOURCE=admin
# Alternativa: MONGODB_URI=mongodb://cem:cemlocal@127.0.0.1:27027/cem-db_distribuccion?authSource=admin

# Mongo con Docker Compose (docker-compose.yml sobrescribe host/puerto internos)
# MONGODB_HOST=mongo
# MONGODB_PORT=27017

# SSO CEM (deshabilitado por ahora; SSO_ENABLED=true para activar)
SSO_ENABLED=false
# SSO_VALIDAR_URL=http://192.168.1.252:5000/api/v1/validar-sesion

# =============================================================================
# SIESA Connekta — solo 2 ambientes
# REAL = https://servicios.siesacloud.com
# QA   = https://serviciosqa.siesacloud.com
# Por consulta cambia: nombre + ConnKey + ConniToken (un par = un usuario).
# Connekta idCompania=55. UnoEE Cárnicos=13.
# =============================================================================
SIESA_ID_COMPANIA=55
SIESA_ID_CIA=13

# --- ITEMS | REAL | v3.1 ---
SIESA_BASE_URL=https://servicios.siesacloud.com/api/connekta/v3.1/ejecutarconsulta
SIESA_CONSULTA_ITEMS=carnicosyalimentos_GET_ITEMS
SIESA_CONNI_KEY=
SIESA_CONNI_TOKEN=

# --- PEDIDOS | QA | v3 Detalle_pedidos_ventas ---
# parametros=fechaDesde = YYYY-MM-DD|fechaHasta = YYYY-MM-DD
SIESA_PEDIDOS_BASE_URL=https://serviciosqa.siesacloud.com/api/connekta/v3/ejecutarconsulta
SIESA_CONSULTA_PEDIDOS=carnicosyalimentos_Detalle_pedidos_ventas
SIESA_PEDIDOS_CONNI_KEY=
SIESA_PEDIDOS_CONNI_TOKEN=
SIESA_PEDIDOS_ID_COMPANIA=55
SIESA_PEDIDOS_USA_PARAMETROS=true
SIESA_PEDIDOS_PARAMETROS=fechaDesde = {fechaDesde}|fechaHasta = {fechaHasta}
SIESA_PEDIDOS_FECHA_DESDE=2026-01-01
SIESA_PEDIDOS_FECHA_HASTA=2026-01-31
SIESA_PEDIDOS_TAM_PAG=100
# npm run etl:pedidos -- --desde 2026-01-16 --hasta 2026-01-19

# Sync automática de pedidos (false = solo botón manual)
SIESA_PEDIDOS_CRON=false
# SIESA_PEDIDOS_CRON_EXPR=0 6 * * *


# --- CLIENTES | QA | v3.1 (si key vacía, usa pedidos) ---
SIESA_CLIENTES_BASE_URL=https://serviciosqa.siesacloud.com/api/connekta/v3.1/ejecutarconsulta
SIESA_CONSULTA_CLIENTES=carnicosyalimentos_TercerosClienteDinamico
SIESA_CLIENTES_CONNI_KEY=
SIESA_CLIENTES_CONNI_TOKEN=

# --- FACTURAS | QA | v3 (si key vacía, usa pedidos) ---
# Líneas; agrupa por TipoDoc-NumDoc. No admite parámetros de fecha.
SIESA_FACTURAS_BASE_URL=https://serviciosqa.siesacloud.com/api/connekta/v3/ejecutarconsulta
SIESA_CONSULTA_FACTURAS=carnicosyalimentos_Prevalentware_facturas
SIESA_FACTURAS_CONNI_KEY=
SIESA_FACTURAS_CONNI_TOKEN=
# SIESA_FACTURAS_TAM_PAG=100
# SIESA_FACTURAS_MAX_PAGINAS=2
# SIESA_FACTURAS_TIMEOUT_MS=180000

# --- BODEGAS | QA | v3.1 (si key vacía, usa pedidos) ---
SIESA_BODEGAS_BASE_URL=https://serviciosqa.siesacloud.com/api/connekta/v3.1/ejecutarconsulta
SIESA_CONSULTA_BODEGAS=carnicosyalimentos_Bodegas
SIESA_BODEGAS_CONNI_KEY=
SIESA_BODEGAS_CONNI_TOKEN=

# --- EXISTENCIAS | REAL | v3 ---
SIESA_EXISTENCIAS_BASE_URL=https://servicios.siesacloud.com/api/connekta/v3/ejecutarconsulta
SIESA_CONSULTA_EXISTENCIAS=carnicosyalimentos_innova_inven_a_la_fecha_FV
# Existencias ETC (kg UM1 + und UM2). SQL: backend/src/services/siesaExistencias.consulta.sql
SIESA_CONSULTA_EXISTENCIAS_BODEGA=carnicosyalimentos_existencias_por_bodega
SIESA_EXISTENCIAS_CONNI_KEY=
SIESA_EXISTENCIAS_CONNI_TOKEN=
INVENTARIO_EXISTENCIAS_FUENTE=connekta
# INVENTARIO_EXISTENCIAS_FUENTE=cem
# SIESA_EXISTENCIAS_BODEGAS_CIA=002,PT001,PT003,PT002,001,BM004,PT DV,008,PT004,PT0PV,009,BM002,BM001,011,BM003,PT005,PT006,PT007

# --- ST abiertas (sin ET). SQL en backend/src/services/siesaSt.consulta.sql ---
INVENTARIO_ST_FUENTE=connekta

# --- ST | REAL | v3 ---
SIESA_ST_BASE_URL=https://servicios.siesacloud.com/api/connekta/v3/ejecutarconsulta
SIESA_CONSULTA_ST=carnicosyalimentos_carnicosyalimentos_documentos_ST
SIESA_ST_CONNI_KEY=
SIESA_ST_CONNI_TOKEN=
# SIESA_ST_ESPERA_MS=0
# SIESA_ST_FECHA_DESDE=2026-01-01

# --- COMPROMISOS (conectoresimportar) | QA ---
SIESA_COMPROMISOS_URL=https://serviciosqa.siesacloud.com/api/siesa/v3.1/conectoresimportar
SIESA_ID_SISTEMA=1
SIESA_COMPROMISOS_ID_DOCUMENTO=253555
SIESA_COMPROMISOS_NOMBRE=PedidosCompromisos

# API interna de existencias (otro servicio CEM, puerto 5015)
CEM_INVENTARIO_API=http://192.168.1.252:5015/api/v1
