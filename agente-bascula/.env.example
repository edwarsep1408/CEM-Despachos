# Un archivo .env por cada PC de muelle. No se sube a git.
# Local: 127.0.0.1 · Docker (piso): 0.0.0.0
HOST=127.0.0.1
PORT=3920

# Convertidor Ethernet-Serie de ESTE muelle (IP LAN del convertidor).
# USR-TCP232: TCP Server, Local Port (a menudo 5001).
# NetUART: TCP Mode = Server, Port Number (a menudo 23).
BASCULA_IP=192.168.1.110
BASCULA_PUERTO=23
